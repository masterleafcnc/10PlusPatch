		</Behaviors>
		<AI>
			<AIUpdate
				id="ModuleTag_AI"
				AILuaEventsList="PhaseDummyFunctions_R24" />
		</AI>
		<Body>
			<ActiveBody
				id="ModuleTag_Body"
				MaxHealth="100.0" />
		</Body>
